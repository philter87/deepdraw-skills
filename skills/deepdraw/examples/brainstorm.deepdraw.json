    "p1": { "type": "sticky", "x": 70, "y": 660, "w": 200, "h": 110, "rotation": -1.5, "text": "Does legal check\nany of these?", "style": { "fill": "#f1f5f9", "stroke": "#475569" } },
    "p2": { "type": "sticky", "x": 340, "y": 660, "w": 200, "h": 110, "rotation": 1, "text": "Domain, or\nwe are pretending", "style": { "fill": "#f1f5f9", "stroke": "#475569" } },
    "p3": { "type": "sticky", "x": 610, "y": 660, "w": 200, "h": 110, "rotation": -1, "text": "Ship it unnamed?\nNobody said no.", "style": { "fill": "#f1f5f9", "stroke": "#475569" } },

